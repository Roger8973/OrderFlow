@OrderFlow.Api_HostAddress = http://localhost:5164

### Create a customer (valid) - 201
POST {{OrderFlow.Api_HostAddress}}/customers
Content-Type: application/json

{
  "name": "Maria Silva",
  "email": "maria@example.com",
  "phone": "+55 11 99999-0000"
}

### Create a customer (invalid: blank name, malformed email) - 400
POST {{OrderFlow.Api_HostAddress}}/customers
Content-Type: application/json

{
  "name": "   ",
  "email": "not-an-email"
}

### Create a customer (duplicate email; run the valid request first) - 409
POST {{OrderFlow.Api_HostAddress}}/customers
Content-Type: application/json

{
  "name": "Maria Duplicada",
  "email": "Maria@Example.com"
}

### Get a customer by id (replace with an id returned by POST /customers) - 200
GET {{OrderFlow.Api_HostAddress}}/customers/00000000-0000-0000-0000-000000000001

### Get a customer by id (well-formed GUID, unknown customer) - 404
GET {{OrderFlow.Api_HostAddress}}/customers/00000000-0000-0000-0000-000000000000

### Get a customer by id (not a GUID) - 404
GET {{OrderFlow.Api_HostAddress}}/customers/not-a-guid
